module(name = "rules_sudo_reference_backend", version = "0.0.0")

bazel_dep(name = "rules_sudo", version = "1.0.0")
local_path_override(
    module_name = "rules_sudo",
    path = "../..",
)

bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_rust", version = "0.72.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")
use_repo(python, "python_3_12")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.96.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# The hermetic decomposed lockstep needs the matched set of first-party binaries
# (sudoc + lockstep_diff + capture_run + emit_unpack). No published release ships
# them yet (they land with the matched-pair release, design §8 Phase 5 Task 8),
# so this example is driven against a HEAD build via sudo.local_binary — exactly
# how a downstream repo validates against pre-release binaries. `./verify.sh`
# regenerates the paths below to point at the parent repo's freshly-built
# binaries and runs the test. After the matched-pair release, replace this block
# with `sudo.toolchain(version = "<tag>")`.
sudo = use_extension("@rules_sudo//:extensions.bzl", "sudo")
# These four paths are PLACEHOLDERS. Until ./verify.sh rewrites them, any bazel
# command in this directory fails with `1 input file(s) do not exist` -- bazel
# does not name the missing file, so the error looks like a broken example. It
# is not: run ./verify.sh. (verify.sh matches these by regex, so the placeholder
# text itself is free to change.)
sudo.local_binary(
    sudoc = "/RUN-verify.sh-FIRST-placeholder/sudoc",
    lockstep_diff = "/RUN-verify.sh-FIRST-placeholder/lockstep_diff",
    capture_run = "/RUN-verify.sh-FIRST-placeholder/capture_run",
    emit_unpack = "/RUN-verify.sh-FIRST-placeholder/emit_unpack",
)
use_repo(sudo, "sudo_toolchain")
