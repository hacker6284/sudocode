# Lean 4 backend (external, protocol 4).
#
# The emitter is Python (stdlib json only) so the Bazel codegen action does not
# need Lean on PATH — unlike Haskell, whose emit.sh shells out to `runghc`.
# The lockstep *run-leaf* invokes generated `build_test.sh` (`lake build` +
# Darwin LC_RPATH) then the raw `.lake/build/bin/{entry}_test` binary — same
# shape as hs/zig/swift. That is what requires Lean 4.14 / lake on PATH.
#
# Registered as `sudo_external_backend` the same way as //backends/haskell:hs
# and listed in ALL_BACKENDS (tools/backends.bzl). Empty `predicates` means
# full IR; do not add `predicates = ["terminates"]`.

load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@rules_sudo//:defs.bzl", "sudo_external_backend")

py_library(
    name = "emit_lib",
    srcs = ["emit.py"],
    # So `import emit` resolves (rules_python otherwise roots imports at the workspace).
    imports = ["."],
)

py_test(
    name = "emit_repr_test",
    srcs = ["emit_repr_test.py"],
    main = "emit_repr_test.py",
    data = [
        "repr_rules.sudo",
        "//sudoc/crates/cli:sudoc",
    ],
    env = {"SUDOC_BIN": "$(rootpath //sudoc/crates/cli:sudoc)"},
    deps = [
        ":emit_lib",
        "@rules_python//python/runfiles",
    ],
)

sh_binary(
    name = "emitter",
    srcs = ["emit.sh"],
    data = [
        "emit.py",
        "SudoRt.lean",
    ],
    visibility = ["//visibility:public"],
)

sudo_external_backend(
    name = "lean",
    emitter = ":emitter",
    # Host compile (like hs `ghc -o`). The generated script runs `lake build`
    # then, on Darwin, bakes LC_RPATH / collocates @rpath dylibs so the raw
    # binary resolves libleanshared without DYLD_* (SIP strips those from
    # /bin/bash). recipe_run is the binary, matching hs/zig/swift.
    recipe_build = [["/bin/bash", "./build_test.sh"]],
    recipe_run = ["./.lake/build/bin/{entry}_test"],
    visibility = ["//visibility:public"],
)
