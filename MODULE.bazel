module(name = "sudocode", version = "0.1.0")

bazel_dep(name = "rules_rust", version = "0.72.0")

# Phase 5: the lockstep macros now ship as rules_sudo 1.0.0. sudocode dogfoods
# its own pre-release ruleset via local_path_override, and OVERRIDES the macros'
# sudoc/capture_run/lockstep_diff/emit_unpack label attrs to its freshly-built
# first-party binaries (//sudoc/crates/...), so @sudo_toolchain (a release
# fetch) is never instantiated here — no chicken-and-egg. See the design spec
# §4/§6 and constraint "dogfood, don't release".
bazel_dep(name = "rules_sudo", version = "1.0.0")
local_path_override(
    module_name = "rules_sudo",
    path = "rules_sudo",
)

# For select() on @platforms//os:* (the C-sanitizer gate is Linux-strict).
bazel_dep(name = "platforms", version = "1.1.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.96.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//sudoc:Cargo.lock",
    manifests = [
        "//sudoc:Cargo.toml",
        "//sudoc/crates/syntax:Cargo.toml",
        "//sudoc/crates/types:Cargo.toml",
        "//sudoc/crates/ir:Cargo.toml",
        "//sudoc/crates/sdk:Cargo.toml",
        "//sudoc/crates/stdlib:Cargo.toml",
        "//sudoc/crates/backend_py:Cargo.toml",
        "//sudoc/crates/backend_c:Cargo.toml",
        "//sudoc/crates/backend_js:Cargo.toml",
        "//sudoc/crates/backend_swift:Cargo.toml",
        "//sudoc/crates/backend_rs:Cargo.toml",
        "//sudoc/crates/backend_zig:Cargo.toml",
        "//sudoc/crates/backend_ext:Cargo.toml",
        "//sudoc/crates/harness:Cargo.toml",
        "//sudoc/crates/cli:Cargo.toml",
    ],
)
use_repo(crate, "crates")

# Hermetic Python interpreter for the `py` lockstep run-leaf (verifiable-slice
# hermeticity, design §5/§9). Pins the py backend to a fixed CPython instead of
# whatever `python3` is on the runner's PATH. `ignore_root_user_error` is needed
# only because this dev container builds as root; CI runners are non-root and
# unaffected — the flag is a harmless no-op there.
# 1.7.0 to agree with rules_sudo (Phase 5); the py run-leaf's hermetic
# interpreter comes from this toolchain.
bazel_dep(name = "rules_python", version = "1.7.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
    is_default = True,
    ignore_root_user_error = True,
)
use_repo(python, "python_3_12")
