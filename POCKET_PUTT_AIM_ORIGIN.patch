@@ -0,0 +1,102 @@
+'use strict';
+/**
+ * Click-origin aim contract:
+ * - pointerVec is measured from the click (virtual ball), not the live ball
+ * - launch velocity depends only on that drag vector
+ * - game + editor measure from origin, not ball.x/y
+ */
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const Shared = require('../shared.js');
+
+const {
+  aimDragFromOrigin, computeLaunchVelocity, clampDragVector,
+  MAX_DRAG_DIST, MIN_DRAG_DIST,
+} = Shared;
+
+let passed = 0;
+function test(name, fn) {
+  try {
+    fn();
+    passed++;
+    console.log('  ok  ' + name);
+  } catch (e) {
+    console.error('  FAIL  ' + name);
+    console.error('    ' + (e && e.message ? e.message : e));
+    process.exitCode = 1;
+  }
+}
+
+console.log('aim-origin');
+
+test('exports aimDragFromOrigin', () => {
+  assert.strictEqual(typeof aimDragFromOrigin, 'function');
+});
+
+test('drag is relative to origin, not the live ball', () => {
+  const origin = { x: 600, y: 80 };
+  const pointer = { x: 600 - 80, y: 80 + 20 };
+  const v = aimDragFromOrigin(origin, pointer);
+  assert.ok(Math.abs(v.x - (-80)) < 1e-9, 'vx from origin');
+  assert.ok(Math.abs(v.y - 20) < 1e-9, 'vy from origin');
+  // Same pointer vs a ball sitting elsewhere must NOT be used as the drag.
+  const ball = { x: 80, y: 250 };
+  const fromBall = { x: pointer.x - ball.x, y: pointer.y - ball.y };
+  assert.ok(Math.hypot(fromBall.x - v.x, fromBall.y - v.y) > 50, 'must not measure from ball');
+});
+
+test('identical offset from two origins yields identical launch', () => {
+  const drag = { x: -90, y: 30 };
+  const a = aimDragFromOrigin({ x: 100, y: 100 }, { x: 100 + drag.x, y: 100 + drag.y });
+  const b = aimDragFromOrigin({ x: 700, y: 400 }, { x: 700 + drag.x, y: 400 + drag.y });
+  assert.ok(Math.abs(a.x - b.x) < 1e-9 && Math.abs(a.y - b.y) < 1e-9);
+  const la = computeLaunchVelocity(a);
+  const lb = computeLaunchVelocity(b);
+  assert.ok(Math.abs(la.vx - lb.vx) < 1e-9 && Math.abs(la.vy - lb.vy) < 1e-9);
+});
+
+test('clamps to MAX_DRAG_DIST', () => {
+  const v = aimDragFromOrigin({ x: 0, y: 0 }, { x: 400, y: 0 });
+  assert.ok(Math.abs(v.x - MAX_DRAG_DIST) < 1e-9);
+  assert.ok(Math.abs(v.y) < 1e-9);
+});
+
+test('missing origin or pointer is a zero drag', () => {
+  assert.deepStrictEqual(aimDragFromOrigin(null, { x: 1, y: 1 }), { x: 0, y: 0 });
+  assert.deepStrictEqual(aimDragFromOrigin({ x: 1, y: 1 }, null), { x: 0, y: 0 });
+});
+
+test('launch still rejects sub-MIN_DRAG_DIST via clampDragVector', () => {
+  const v = aimDragFromOrigin({ x: 10, y: 10 }, { x: 10 + MIN_DRAG_DIST / 2, y: 10 });
+  assert.strictEqual(clampDragVector(v), null);
+});
+
