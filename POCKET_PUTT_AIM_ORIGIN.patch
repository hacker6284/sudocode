+/**
+ * Aim drag is measured from the click-origin (virtual / ghost ball), not the live ball.
+ * The resulting vector is what computeLaunchVelocity consumes — same units as today's
+ * pointerVec — then applied to the actual ball.
+ */
+function aimDragFromOrigin(origin, pointer, maxDist) {
+  maxDist = maxDist == null ? MAX_DRAG_DIST : maxDist;
+  if (!origin || !pointer) return { x: 0, y: 0 };
+  let vx = pointer.x - origin.x;
+  let vy = pointer.y - origin.y;
+  const len = Math.hypot(vx, vy);
+  if (len > maxDist && len > 0) {
+    vx = (vx / len) * maxDist;
+    vy = (vy / len) * maxDist;
+  }
+  return { x: vx, y: vy };
+}
