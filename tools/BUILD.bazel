# Package marker so //tools:backends.bzl is loadable. Also hosts
# inject_release_shas and its unit tests (//tools:inject_release_shas_test).

load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "inject_release_shas_lib",
    srcs = ["inject_release_shas.py"],
    # Put this package on PYTHONPATH so `import inject_release_shas` works
    # (rules_python defaults to workspace-rooted imports otherwise).
    imports = ["."],
)

py_test(
    name = "inject_release_shas_test",
    srcs = ["inject_release_shas_test.py"],
    main = "inject_release_shas_test.py",
    # Real versions.bzl for the PLATFORM_TRIPLES / RELEASE_ASSETS drift guard.
    data = ["//rules_sudo:versions.bzl"],
    deps = [
        ":inject_release_shas_lib",
        "@rules_python//python/runfiles",
    ],
)

# Forcing function for the post-release promotion step: the release workflow
# injects shas into the TARBALL's versions.bzl and nothing writes them back to
# the repo, so a shipped tag can silently end up with no literal entry (v0.5.0
# did, and was backfilled by hand). Reads the real git tags, so it runs local
# and unsandboxed; it skips itself when .git is absent (shallow CI clones).
py_test(
    name = "versions_complete_test",
    srcs = ["versions_complete_test.py"],
    main = "versions_complete_test.py",
    data = ["//rules_sudo:versions.bzl"],
    local = True,
    tags = ["no-sandbox"],
)
