// MegaDreifach. The rules are primitives/hash/megadreifach/SPEC.md.
// A toy three-megaminx Merkle-Damgard hash. Not for real use.
// Product name MegaDreifach is locked. The puzzle/group is megaminx.
// A sudocode int is 64-bit and overflow traps; |G| and 52! need pasted bigint.
// Tests lock pad, φ, IV-COOK12, rank, the group law, and the public API.
// Research Hash hexes in kats/megaminx_hash_kats.json are not asserted here.

pad_block = 28
len_field = 8
digest_len = 29
body_len = 52
f3_t = 12
held_up = 0
held_front = 1
limb_base = 1000000000
