func face_nbrs(f: int) -> List<int>
    if f == 0
        return nbrs_0
    else if f == 1
        return nbrs_1
    else if f == 2
        return nbrs_2
    else if f == 3
        return nbrs_3
    else if f == 4
        return nbrs_4
    else if f == 5
        return nbrs_5
    else if f == 6
        return nbrs_6
    else if f == 7
        return nbrs_7
    else if f == 8
        return nbrs_8
    else if f == 9
        return nbrs_9
    else if f == 10
        return nbrs_10
    return nbrs_11

func corner_faces(slot: int) -> (int, int, int)
    if slot == 0
        return (0, 1, 2)
    else if slot == 1
        return (0, 2, 3)
    else if slot == 2
        return (0, 3, 4)
    else if slot == 3
        return (0, 4, 5)
    else if slot == 4
        return (0, 5, 1)
    else if slot == 5
        return (1, 5, 6)
    else if slot == 6
        return (1, 6, 7)
    else if slot == 7
        return (1, 7, 2)
    else if slot == 8
        return (2, 7, 8)
    else if slot == 9
        return (2, 8, 3)
    else if slot == 10
        return (3, 8, 9)
    else if slot == 11
        return (3, 9, 4)
    else if slot == 12
        return (4, 9, 10)
    else if slot == 13
        return (4, 10, 5)
    else if slot == 14
        return (5, 10, 6)
    else if slot == 15
        return (6, 10, 11)
    else if slot == 16
        return (6, 11, 7)
    else if slot == 17
        return (7, 11, 8)
    else if slot == 18
        return (8, 11, 9)
    return (9, 11, 10)

