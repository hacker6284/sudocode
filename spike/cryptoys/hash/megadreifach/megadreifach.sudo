func rot_slice(off: int) -> List<int>
    out: List<int> = []
    for i = 0 to 11
        out.append(rots_flat[off + i])
    return out

func rot_at(s: int) -> List<int>
    return rot_slice(s * 12)

func range_list(n: int) -> List<int>
    xs: List<int> = []
    for i = 0 to n - 1
        xs.append(i)
    return xs

func zeros(n: int) -> List<int>
    return filled(n, 0)

func identity() -> Position
    return Position(range_list(20), zeros(20), range_list(30), zeros(30))

func compose(g: Position, h: Position) -> Position
    cp: List<int> = []
    co: List<int> = []
    for s = 0 to 19
        cp.append(h.cp[g.cp[s]])
        co.append((h.co[g.cp[s]] + g.co[s]) mod 3)
    ep: List<int> = []
    eo: List<int> = []
    for s = 0 to 29
        ep.append(h.ep[g.ep[s]])
        eo.append((h.eo[g.ep[s]] + g.eo[s]) mod 2)
    return Position(cp, co, ep, eo)

func inverse(g: Position) -> Position
    cp_inv = filled(20, 0)
    for s = 0 to 19
        cp_inv[g.cp[s]] = s
    co_inv = filled(20, 0)
    for s = 0 to 19
        co_inv[s] = (3 - (g.co[cp_inv[s]] mod 3)) mod 3
    ep_inv = filled(30, 0)
    for s = 0 to 29
        ep_inv[g.ep[s]] = s
    eo_inv = filled(30, 0)
    for s = 0 to 29
        eo_inv[s] = (2 - (g.eo[ep_inv[s]] mod 2)) mod 2
    return Position(cp_inv, co_inv, ep_inv, eo_inv)

func face_turn(g: Position, face: int, amount: int) -> Position
    a = amount mod 5
    if a == 0
        return g
    t = face_move(face)
    out = g
    for i = 1 to a
        out = compose(t, out)
    return out

func iv_cook12() -> Position
    g = identity()
    for f = 0 to 11
        g = face_turn(g, f, 1)
    return g

func big_zero() -> BigInt
    empty: List<int> = []
    return BigInt(false, empty)

func trim(limbs: List<int>) -> List<int>
    n = limbs.length
    while n > 0 and limbs[n - 1] == 0
        n = n - 1
    out: List<int> = []
    for i = 0 to n - 1
        out.append(limbs[i])
    return out

func make_big(negative: bool, limbs: List<int>) -> BigInt
    t = trim(limbs)
    if t.length == 0
        return big_zero()
    return BigInt(negative, t)

func mag_cmp(a: List<int>, b: List<int>) -> int
    if a.length < b.length
        return -1
    if b.length < a.length
        return 1
    for i = a.length - 1 downto 0
        if a[i] < b[i]
            return -1
        if b[i] < a[i]
            return 1
    return 0

func mag_add(a: List<int>, b: List<int>) -> List<int>
    out: List<int> = []
    carry = 0
    n = a.length
    if b.length > n
        n = b.length
    for i = 0 to n - 1
        cur = carry
        if i < a.length
            cur = cur + a[i]
        if i < b.length
            cur = cur + b[i]
        out.append(cur mod limb_base)
        carry = cur / limb_base
    if carry > 0
        out.append(carry)
    return out

func mag_sub(a: List<int>, b: List<int>) -> List<int>
    out: List<int> = []
    borrow = 0
    for i = 0 to a.length - 1
        cur = a[i] - borrow
        if i < b.length
            cur = cur - b[i]
        if cur < 0
            cur = cur + limb_base
            borrow = 1
        else
            borrow = 0
        out.append(cur)
    return trim(out)

func big_from_int(v: int) -> BigInt
    if v == 0
        return big_zero()
    assert v >= 0
    limbs: List<int> = []
    m = v
    while m > 0
        limbs.append(m mod limb_base)
        m = m / limb_base
    return BigInt(false, limbs)

func big_add(a: BigInt, b: BigInt) -> BigInt
    return make_big(false, mag_add(a.limbs, b.limbs))

func big_mul(a: BigInt, b: BigInt) -> BigInt
    if a.limbs.length == 0 or b.limbs.length == 0
        return big_zero()
    out = filled(a.limbs.length + b.limbs.length, 0)
    for i = 0 to a.limbs.length - 1
        carry = 0
        for j = 0 to b.limbs.length - 1
            cur = out[i + j] + a.limbs[i] * b.limbs[j] + carry
            out[i + j] = cur mod limb_base
            carry = cur / limb_base
        k = i + b.limbs.length
        while carry > 0
            cur = out[k] + carry
            out[k] = cur mod limb_base
            carry = cur / limb_base
            k = k + 1
    return make_big(false, out)

func big_divmod_small(a: BigInt, d: int) -> (BigInt, int)
    assert d > 0 and d < limb_base
    if a.limbs.length == 0
        return (big_zero(), 0)
    q = filled(a.limbs.length, 0)
    rem = 0
    for i = a.limbs.length - 1 downto 0
        cur = rem * limb_base + a.limbs[i]
        q[i] = cur / d
        rem = cur mod d
    return (make_big(false, q), rem)

func big_from_be(bs: List<int>) -> BigInt
    n = big_zero()
    two56 = big_from_int(256)
    for i = 0 to bs.length - 1
        n = big_add(big_mul(n, two56), big_from_int(bs[i]))
    return n

func big_to_be(n: BigInt, width: int) -> List<int>
    acc = n
    rev: List<int> = []
    for i = 1 to width
        acc, r = big_divmod_small(acc, 256)
        rev.append(r)
    out: List<int> = []
    for i = rev.length - 1 downto 0
        out.append(rev[i])
    return out

func big_factorial(n: int) -> BigInt
    r = big_from_int(1)
    for i = 2 to n
        r = big_mul(r, big_from_int(i))
    return r

func two224() -> BigInt
    n = big_from_int(1)
    two = big_from_int(2)
    for i = 1 to 224
        n = big_mul(n, two)
    return n

func even30() -> BigInt
    f = big_factorial(30)
    q, r = big_divmod_small(f, 2)
    assert r == 0
    return q

func limb_to_small(n: BigInt) -> int
    acc = 0
    place = 1
    for i = 0 to n.limbs.length - 1
        acc = acc + n.limbs[i] * place
        place = place * limb_base
    return acc

func peel_leading(n: BigInt, d: int) -> (BigInt, int)
    q = n
    for f = 2 to d
        q, rr = big_divmod_small(q, f)
    idx = limb_to_small(q)
    fact = big_factorial(d)
    prod = big_mul(big_from_int(idx), fact)
    rest = make_big(false, mag_sub(n.limbs, prod.limbs))
    return (rest, idx)

func pad_z(msg_len: int) -> int
    return (pad_block - (msg_len + 1 + len_field) mod pad_block) mod pad_block

export func pad_message(msg: List<int>) -> List<int>
    for i = 0 to msg.length - 1
        assert (msg[i] >= 0) and (msg[i] <= 255)
    bitlen = 8 * msg.length
    z = pad_z(msg.length)
    out: List<int> = []
    for i = 0 to msg.length - 1
        out.append(msg[i])
    out.append(128)
    for i = 1 to z
        out.append(0)
    lenb = big_to_be(big_from_int(bitlen), 8)
    for i = 0 to 7
        out.append(lenb[i])
    return out

func phi_chunk(chunk: List<int>) -> List<int>
    assert chunk.length == pad_block
    rem = big_from_be(chunk)
    avail = range_list(52)
    out: List<int> = []
    for i = 0 to 51
        d = 51 - i
        if d == 0
            out.append(avail[0])
        else
            rem, idx = peel_leading(rem, d)
            assert (idx >= 0) and (idx < avail.length)
            out.append(avail[idx])
            fresh: List<int> = []
            for t = 0 to avail.length - 1
                if t != idx
                    fresh.append(avail[t])
            avail = fresh
    return out

func phi_inv(deal: List<int>) -> List<int>
    avail = range_list(52)
    n = big_zero()
    for i = 0 to 51
        v = deal[i]
        idx = 0
        while avail[idx] != v
            idx = idx + 1
        n = big_add(big_mul(n, big_from_int(52 - i)), big_from_int(idx))
        fresh: List<int> = []
        for t = 0 to avail.length - 1
            if t != idx
                fresh.append(avail[t])
        avail = fresh
    assert mag_cmp(n.limbs, two224().limbs) < 0
    return big_to_be(n, pad_block)

export func require_permutation(deal: List<int>) -> List<int>
    assert deal.length == body_len
    seen = filled(52, 0)
    for i = 0 to 51
        c = deal[i]
        assert (c >= 0) and (c < 52)
        assert seen[c] == 0
        seen[c] = 1
    return deal

func even_perm_rank_big(perm: List<int>) -> BigInt
    n = perm.length
    avail = range_list(n)
    rank = big_zero()
    for i = 0 to n - 3
        idx = 0
        while avail[idx] != perm[i]
            idx = idx + 1
        rank = big_add(big_mul(rank, big_from_int(n - i)), big_from_int(idx))
        fresh: List<int> = []
        for t = 0 to avail.length - 1
            if t != idx
                fresh.append(avail[t])
        avail = fresh
    return rank

func pack_ori3(co: List<int>) -> BigInt
    n = big_zero()
    three = big_from_int(3)
    for i = 0 to 18
        n = big_add(big_mul(n, three), big_from_int(co[i]))
    return n

func pack_ori2(eo: List<int>) -> BigInt
    n = big_zero()
    two = big_from_int(2)
    for i = 0 to 28
        n = big_add(big_mul(n, two), big_from_int(eo[i]))
    return n

export func position_to_bytes(p: Position) -> List<int>
    n = even_perm_rank_big(p.cp)
    n = big_add(big_mul(n, big_from_int(ori3_span)), pack_ori3(p.co))
    n = big_mul(n, even30())
    n = big_add(n, even_perm_rank_big(p.ep))
    n = big_mul(n, big_from_int(ori2_span))
    n = big_add(n, pack_ori2(p.eo))
    return big_to_be(n, digest_len)

func noon_phys(phys: int, o: List<int>) -> int
    up = o[held_up]
    front = o[held_front]
    if phys == up
        return front
    nbrs = face_nbrs(phys)
    for i = 0 to 4
        if nbrs[i] == up
            return up
    upn = face_nbrs(up)
    for i = 0 to 4
        for j = 0 to 4
            if nbrs[i] == upn[j]
                return nbrs[i]
    return nbrs[0]

func spin_about_up(o: List<int>, k: int) -> List<int>
    k = k mod 5
    if k == 0
        return o
    up = o[held_up]
    down = opposites[up]
    nbrs = face_nbrs(up)
    dnbrs = face_nbrs(down)
    phys = range_list(12)
    for i = 0 to 4
        phys[nbrs[i]] = nbrs[(i + k) mod 5]
    for i = 0 to 4
        phys[dnbrs[i]] = dnbrs[(i - k + 5) mod 5]
    phys[up] = up
    phys[down] = down
    out: List<int> = []
    for h = 0 to 11
        out.append(phys[o[h]])
    return out

func abs_reorient(c1: int, c2: int) -> List<int>
    for s = 0 to 59
        r = rot_at(s)
        if (r[0] == c1) and (r[1] == c2)
            return r
    assert false
    return range_list(12)

func colour_on(face: int, f0: int, f1: int, f2: int, c0: int, c1: int, c2: int, ori: int) -> int
    loc = 0
    if face == f1
        loc = 1
    if face == f2
        loc = 2
    k = (loc - ori + 3) mod 3
    if k == 0
        return c0
    if k == 1
        return c1
    return c2

func corner_slot(a: int, b: int, c: int) -> int
    x = a
    y = b
    z = c
    if (b < a) and (b < c)
        x = b
        y = c
        z = a
    if (c < a) and (c < b)
        x = c
        y = a
        z = b
    for s = 0 to 19
        f0, f1, f2 = corner_faces(s)
        if ((f0 == x) and (f1 == y)) and (f2 == z)
            return s
    assert false
    return 0

func colours_at(g: Position, a: int, b: int, c: int) -> (int, int)
    slot = corner_slot(a, b, c)
    f0, f1, f2 = corner_faces(slot)
    cubie = g.cp[slot]
    ori = g.co[slot]
    c0, c1, c2 = corner_faces(cubie)
    cf0 = colour_on(a, f0, f1, f2, c0, c1, c2, ori)
    cf1 = colour_on(b, f0, f1, f2, c0, c1, c2, ori)
    return (cf0, cf1)

func recipe_a(g: Position, phys: int, o: List<int>) -> List<int>
    noon = noon_phys(phys, o)
    nbrs = face_nbrs(phys)
    ni = 0
    for i = 0 to 4
        if nbrs[i] == noon
            ni = i
    next_cw = nbrs[(ni + 1) mod 5]
    c1, c2 = colours_at(g, phys, noon, next_cw)
    return abs_reorient(c1, c2)

func g2_step(g: Position, o: List<int>, card: int) -> (Position, List<int>)
    rank = card / 4
    suit = card mod 4
    amt = suit + 1
    o_work = o
    held = rank
    if rank < 12
        g = face_turn(g, o_work[held], amt)
    else
        held = held_up
        g = face_turn(g, o_work[held], (5 - amt) mod 5)
        o_work = spin_about_up(o_work, amt)
    noon = noon_phys(o_work[held], o_work)
    if noon != o_work[held]
        g = face_turn(g, noon, 1)
    g = face_turn(g, o_work[held_front], 1)
    return (g, recipe_a(g, o_work[held], o_work))

func f3_step(g: Position, o: List<int>) -> (Position, List<int>)
    g = face_turn(g, o[held_up], 1)
    return (g, recipe_a(g, o[held_up], o))

func em_block(h: Position, deal: List<int>) -> Position
    g = h
    o = range_list(12)
    for i = 0 to 51
        g, o = g2_step(g, o, deal[i])
    for t = 1 to f3_t
        g, o = f3_step(g, o)
    return g

export func Hash(msg: List<int>) -> List<int>
    padded = pad_message(msg)
    assert padded.length > 0
    assert padded.length mod pad_block == 0
    h = iv_cook12()
    i = 0
    while i < padded.length
        chunk: List<int> = []
        for j = 0 to 27
            chunk.append(padded[i + j])
        deal = phi_chunk(chunk)
        e = em_block(h, deal)
        h = compose(h, e)
        i = i + pad_block
    return position_to_bytes(h)

export func MegaDreifach(msg: List<int>) -> List<int>
    return Hash(msg)

export func HashDeck(deal: List<int>) -> List<int>
    deal = require_permutation(deal)
    raw = phi_inv(deal)
    return Hash(raw)

export func MegaDreifachDeck(deal: List<int>) -> List<int>
    return HashDeck(deal)

func body_from(deal: List<int>, h: Position) -> List<int>
    deal = require_permutation(deal)
    e = em_block(h, deal)
    return position_to_bytes(compose(h, e))

export func HashDeckBody(deal: List<int>) -> List<int>
    return body_from(deal, iv_cook12())

export func MegaDreifachBody(deal: List<int>) -> List<int>
    return HashDeckBody(deal)

export func HashDeckBodyFrom(deal: List<int>, h: Position) -> List<int>
    return body_from(deal, h)

export func MegaDreifachBodyFrom(deal: List<int>, h: Position) -> List<int>
    return HashDeckBodyFrom(deal, h)

func hex_iv() -> List<int>
    return [0, 0, 2, 26, 235, 135, 110, 183, 109, 216, 191, 131, 52, 87, 162, 192, 38, 19, 229, 86, 86, 150, 62, 2, 216, 223, 237, 181, 170]

test "identity rank is 29 zero bytes"
    z = position_to_bytes(identity())
    assert z.length == digest_len
    for i = 0 to 28
        assert z[i] == 0

test "compose inverse round trip"
    t = compose(face_move(3), face_move(7))
    idp = identity()
    left = compose(t, inverse(t))
    right = compose(inverse(t), t)
    assert left.cp == idp.cp
    assert left.co == idp.co
    assert left.ep == idp.ep
    assert left.eo == idp.eo
    assert right.cp == idp.cp
    assert right.co == idp.co
    assert right.ep == idp.ep
    assert right.eo == idp.eo

test "IV-COOK12 digest"
    d = position_to_bytes(iv_cook12())
    assert d == hex_iv()

test "empty pad is one block"
    p = pad_message([])
    assert p.length == 28
    assert p[0] == 128
    for i = 1 to 27
        assert p[i] == 0

test "KAT pad lengths"
    assert pad_message([]).length == 28
    assert pad_message([97, 98, 99]).length == 28
    assert pad_message([0]).length == 28
    m27: List<int> = []
    for i = 0 to 26
        m27.append(i)
    assert pad_message(m27).length == 56
    m28: List<int> = []
    for i = 0 to 27
        m28.append(i)
    assert pad_message(m28).length == 56
    m29: List<int> = []
    for i = 0 to 28
        m29.append(i)
    assert pad_message(m29).length == 56
    m56: List<int> = []
    for i = 1 to 56
        m56.append(109)
    assert pad_message(m56).length == 84
    m100: List<int> = []
    for i = 0 to 99
        m100.append((i * 17) mod 256)
    assert pad_message(m100).length == 112

test "abc pad recovers the 24-bit length"
    p = pad_message([97, 98, 99])
    assert p.length == 28
    assert p[0] == 97
    assert p[1] == 98
    assert p[2] == 99
    assert p[3] == 128
    assert p[27] == 24

test "phi of 28 zero bytes is the identity deal"
    z = filled(28, 0)
    deal = phi_chunk(z)
    assert deal.length == 52
    for i = 0 to 51
        assert deal[i] == i
    assert require_permutation(deal) == deal
    assert phi_inv(deal) == z

test "Hash aliases agree on the empty message"
    d = Hash([])
    assert d.length == digest_len
    assert MegaDreifach([]) == d

test "HashDeckBody on the identity deal is 29 bytes"
    deal = range_list(52)
    b = HashDeckBody(deal)
    assert b.length == digest_len
    assert MegaDreifachBody(deal) == b

test "HashDeckBodyFrom at IV matches HashDeckBody"
    deal = range_list(52)
    iv = iv_cook12()
    from_iv = HashDeckBodyFrom(deal, iv)
    assert from_iv == HashDeckBody(deal)
    assert MegaDreifachBodyFrom(deal, iv) == MegaDreifachBody(deal)
    from_id = HashDeckBodyFrom(deal, identity())
    assert from_id.length == digest_len
    assert from_id != from_iv

test "require_permutation rejects a duplicate"
    bad = filled(52, 0)
    expect_trap AssertFailed
        require_permutation(bad)
