func face_move(face: int) -> Position
    if face == 0
        return Position(ft_cp_0, ft_co_0, ft_ep_0, ft_eo_0)
    else if face == 1
        return Position(ft_cp_1, ft_co_1, ft_ep_1, ft_eo_1)
    else if face == 2
        return Position(ft_cp_2, ft_co_2, ft_ep_2, ft_eo_2)
    else if face == 3
        return Position(ft_cp_3, ft_co_3, ft_ep_3, ft_eo_3)
    else if face == 4
        return Position(ft_cp_4, ft_co_4, ft_ep_4, ft_eo_4)
    else if face == 5
        return Position(ft_cp_5, ft_co_5, ft_ep_5, ft_eo_5)
    else if face == 6
        return Position(ft_cp_6, ft_co_6, ft_ep_6, ft_eo_6)
    else if face == 7
        return Position(ft_cp_7, ft_co_7, ft_ep_7, ft_eo_7)
    else if face == 8
        return Position(ft_cp_8, ft_co_8, ft_ep_8, ft_eo_8)
    else if face == 9
        return Position(ft_cp_9, ft_co_9, ft_ep_9, ft_eo_9)
    else if face == 10
        return Position(ft_cp_10, ft_co_10, ft_ep_10, ft_eo_10)
    return Position(ft_cp_11, ft_co_11, ft_ep_11, ft_eo_11)

