load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "types",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    crate_name = "sudoc_types",
    rustc_flags = ["-Dunsafe_code"],
    deps = [
        "//sudoc/crates/syntax:syntax",
        "//sudoc/crates/ir:ir",
        "//sudoc/crates/stdlib:stdlib",
    ],
    visibility = ["//visibility:public"],
)

rust_test(name = "types_unit", crate = ":types", edition = "2021")

rust_test(
    name = "types_imports",
    srcs = ["tests/imports.rs"],
    edition = "2021",
    deps = [":types", "//sudoc/crates/ir:ir"],
)

# checker.rs's examples_all_check reads repo-root examples/ via CARGO_MANIFEST_DIR
# at runtime; examples/ staged as data (restores the F8/F10/F12 export-boundary
# coverage under Bazel).
rust_test(
    name = "types_checker",
    srcs = ["tests/checker.rs"],
    edition = "2021",
    deps = [":types", "//sudoc/crates/ir:ir"],
    data = ["//examples:sudo_srcs"],
)

# golden.rs reads examples/ + conformance/golden/*.ir via CARGO_MANIFEST_DIR.
rust_test(
    name = "types_golden",
    srcs = ["tests/golden.rs"],
    edition = "2021",
    deps = [":types", "//sudoc/crates/ir:ir"],
    data = [
        "//examples:sudo_srcs",
        "//conformance:golden_srcs",
    ],
)

load("@rules_rust//rust:defs.bzl", "rust_doc")

# rustdoc -D warnings (parity with cargo doc --no-deps across the workspace);
# built by `bazel build //sudoc/crates/...` in CI.
rust_doc(
    name = "types_doc",
    crate = ":types",
    rustdoc_flags = ["-Dwarnings"],
)
