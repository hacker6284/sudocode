load("@rules_rust//rust:defs.bzl", "rust_library")

exports_files(["Cargo.toml"])

rust_library(
    name = "backend_js",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    crate_name = "sudoc_backend_js",
    rustc_flags = ["-Dunsafe_code"],
    compile_data = glob(["src/runtime/**"]),
    deps = [
        "//sudoc/crates/ir:ir",
        "//sudoc/crates/sdk:sdk",
        "//sudoc/crates/types:types",
    ],
    visibility = ["//visibility:public"],
)

load("@rules_rust//rust:defs.bzl", "rust_test")

rust_test(
    name = "emit",
    srcs = ["tests/emit.rs"],
    edition = "2021",
    deps = [":backend_js", "//sudoc/crates/types:types", "//sudoc/crates/sdk:sdk"],
)

# Host-boundary adapter (lockstep.md §5.4): generate the impl + the host-facing
# API adapter, then run a Node driver that imports the adapter (not the impl).
# The decomposed lockstep tests the impl; this is the only coverage of the
# boundary adapter. tags=local so node resolves from host PATH.
rust_test(
    name = "boundary",
    srcs = ["tests/boundary.rs"],
    edition = "2021",
    tags = ["local"],
    deps = [
        ":backend_js",
        "//sudoc/crates/types:types",
    ],
)

load("@rules_rust//rust:defs.bzl", "rust_doc")

# rustdoc -D warnings (parity with cargo doc --no-deps across the workspace);
# built by `bazel build //sudoc/crates/...` in CI.
rust_doc(
    name = "backend_js_doc",
    crate = ":backend_js",
    rustdoc_flags = ["-Dwarnings"],
)
