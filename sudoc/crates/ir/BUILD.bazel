load("@rules_rust//rust:defs.bzl", "rust_library")

exports_files(["Cargo.toml"])

rust_library(
    name = "ir",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    crate_name = "sudoc_ir",
    rustc_flags = ["-Dunsafe_code"],
    deps = [
        "//sudoc/crates/syntax:syntax",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:schemars",
    ],
    visibility = ["//visibility:public"],
)

load("@rules_rust//rust:defs.bzl", "rust_test")

rust_test(name = "ir_unit", crate = ":ir", edition = "2021")

rust_test(
    name = "ir_roundtrip",
    srcs = ["tests/roundtrip.rs"],
    edition = "2021",
    deps = [":ir"],
)
