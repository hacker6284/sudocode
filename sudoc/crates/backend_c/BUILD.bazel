load("@rules_rust//rust:defs.bzl", "rust_library")

exports_files(["Cargo.toml"])

rust_library(
    name = "backend_c",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    crate_name = "sudoc_backend_c",
    rustc_flags = ["-Dunsafe_code"],
    compile_data = glob(["src/runtime/**"]),
    deps = [
        "//sudoc/crates/ir:ir",
        "//sudoc/crates/sdk:sdk",
        "//sudoc/crates/types:types",
    ],
    visibility = ["//visibility:public"],
)

load("@rules_rust//rust:defs.bzl", "rust_test")

# The C sanitizer gate: proves an instrumented recipe actually links ASan/UBSan
# into the built binary (nm __asan symbols + the ASan init banner). tags=local
# for host cc + nm. SUDOC_REQUIRE_SANITIZE=1 makes a probe that reports
# "unsupported" a hard failure instead of a silent skip — CI cc supports asan,
# so a skip there means the gate went dark (exactly what regressed before).
rust_test(
    name = "sanitizer",
    srcs = ["tests/sanitizer.rs"],
    edition = "2021",
    tags = ["local"],
    # The cc `-fsanitize` support probe (and the asan compile) need the host
    # toolchain env — on macOS clang finds its SDK via DEVELOPER_DIR/SDKROOT.
    # The default rust_test env is stripped, so inherit them (matches the
    # emit-recipe action's use_default_shell_env and the run-leaves' PATH).
    env_inherit = [
        "PATH",
        "CC",
        "DEVELOPER_DIR",
        "SDKROOT",
    ],
    # Hard-require sanitizers on Linux (proven; hermetic_cc's primary target).
    # macOS C-sanitizer support under Bazel is the spec's incomplete frontier
    # (§9 macOS sysroot), so there it's best-effort — the test skips gracefully
    # if the probe can't verify rather than failing the build. Revisited by the
    # hermetic-C work.
    env = select({
        "@platforms//os:linux": {"SUDOC_REQUIRE_SANITIZE": "1"},
        "//conditions:default": {},
    }),
    data = ["//conformance:semantics_srcs"],
    deps = [
        ":backend_c",
        "//sudoc/crates/sdk:sdk",
        "//sudoc/crates/types:types",
    ],
)

load("@rules_rust//rust:defs.bzl", "rust_doc")

# rustdoc -D warnings (parity with cargo doc --no-deps across the workspace);
# built by `bazel build //sudoc/crates/...` in CI.
rust_doc(
    name = "backend_c_doc",
    crate = ":backend_c",
    rustdoc_flags = ["-Dwarnings"],
)
