# Data filegroups for Bazel tests that read the conformance corpus via runfiles
# (CARGO_MANIFEST_DIR at runtime). The lockstep conformance targets themselves
# land in Phase 1a Task 4.

filegroup(
    name = "golden_srcs",
    srcs = glob(["golden/*.ir"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "semantics_srcs",
    srcs = glob(["semantics/*.sudo"]),
    visibility = ["//visibility:public"],
)

load("//tools:lockstep.bzl", "sudo_lockstep_test")

# One lockstep test per semantics module (all self-contained / std-only), py+js
# via the decomposed DAG. //conformance:all is the Phase-1a gate.
_SEMANTICS = [f[len("semantics/"):] for f in glob(["semantics/*.sudo"])]

[
    sudo_lockstep_test(
        name = m[:-len(".sudo")],
        srcs = ["semantics/" + m],
        entry = m,
        backends = ["py", "js", "c", "rs", "zig"],
    )
    for m in _SEMANTICS
]

test_suite(
    name = "all",
    tests = [":" + m[:-len(".sudo")] for m in _SEMANTICS],
)
