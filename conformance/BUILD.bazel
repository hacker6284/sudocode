# Data filegroups for Bazel tests that read the conformance corpus via runfiles
# (CARGO_MANIFEST_DIR at runtime).

filegroup(
    name = "golden_srcs",
    srcs = glob(["golden/*.ir"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "semantics_srcs",
    srcs = glob(["semantics/*.sudo"]),
    visibility = ["//visibility:public"],
)

load("@rules_sudo//:defs.bzl", "sudo_library")
load("//tools:backends.bzl", "dogfood_lockstep_test")

# One lockstep test per semantics module (all self-contained / std-only), across
# all seven backends via the @rules_sudo decomposed DAG. //conformance:all is the
# gate.
_SEMANTICS = [f[len("semantics/"):] for f in glob(["semantics/*.sudo"])]

[
    sudo_library(
        name = m[:-len(".sudo")] + "_lib",
        srcs = ["semantics/" + m],
    )
    for m in _SEMANTICS
]

[
    dogfood_lockstep_test(
        name = m[:-len(".sudo")],
        lib = ":" + m[:-len(".sudo")] + "_lib",
        entry = m,
    )
    for m in _SEMANTICS
]

test_suite(
    name = "all",
    tests = [":" + m[:-len(".sudo")] for m in _SEMANTICS],
)
