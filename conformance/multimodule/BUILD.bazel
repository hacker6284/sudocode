# Multi-module lockstep fixtures (Bazel migration Phase 4). These cross-module /
# import / name-collision regression scenarios previously lived in the harness's
# monolithic tests/lockstep.rs (which ran under cargo only). Migrated to the
# decomposed 7-backend lockstep so they run under Bazel — each module set is
# staged flat and diffed across all backends, exactly like //conformance. Now
# driven by the @rules_sudo 1.0.0 public macros (Phase 5): one sudo_library per
# module set, entry is the importer.

load("@rules_sudo//:defs.bzl", "sudo_library", "sudo_lockstep_test")

# sudocode dogfoods @rules_sudo, overriding the toolchain-binary attrs to its
# freshly-built first-party binaries. hs is the standalone external backend
# `//backends/haskell:hs`, referenced by label.
_SUDOC = "//sudoc/crates/cli:sudoc"
_CAPTURE = "//sudoc/crates/harness:capture_run"
_DIFF = "//sudoc/crates/harness:lockstep_diff"
_UNPACK = "//sudoc/crates/harness:emit_unpack"

_BACKENDS = ["py", "js", "c", "rs", "zig", "swift", "//backends/haskell:hs"]

# Concrete + constant + cross-module generic instantiation through an import.
sudo_library(
    name = "imports_lib",
    srcs = glob(["imports/*.sudo"]),
)

sudo_lockstep_test(
    name = "imports",
    lib = ":imports_lib",
    entry = "main.sudo",
    backends = _BACKENDS,
    sudoc = _SUDOC,
    capture_run = _CAPTURE,
    lockstep_diff = _DIFF,
    emit_unpack = _UNPACK,
)

# Cross-module inout (writeback across a module boundary) + local enum match.
sudo_library(
    name = "xmod_inout_lib",
    srcs = glob(["xmod_inout/*.sudo"]),
)

sudo_lockstep_test(
    name = "xmod_inout",
    lib = ":xmod_inout_lib",
    entry = "xmod_main.sudo",
    backends = _BACKENDS,
    sudoc = _SUDOC,
    capture_run = _CAPTURE,
    lockstep_diff = _DIFF,
    emit_unpack = _UNPACK,
)

# F8 regression: length-prefixed qualification keeps module `a`'s `b_c` and
# module `a_b`'s `c` distinct (both naively flatten to `a_b_c`).
sudo_library(
    name = "f8_collision_lib",
    srcs = glob(["f8_collision/*.sudo"]),
)

sudo_lockstep_test(
    name = "f8_collision",
    lib = ":f8_collision_lib",
    entry = "f8_main.sudo",
    backends = _BACKENDS,
    sudoc = _SUDOC,
    capture_run = _CAPTURE,
    lockstep_diff = _DIFF,
    emit_unpack = _UNPACK,
)

# Cross-module monomorphized generics (Result/Option/List/Tuple) bound to a
# local then matched — the Zig per-module re-declaration regression.
sudo_library(
    name = "xmod_generics_lib",
    srcs = glob(["xmod_generics/*.sudo"]),
)

sudo_lockstep_test(
    name = "xmod_generics",
    lib = ":xmod_generics_lib",
    entry = "xmod_gen_main.sudo",
    backends = _BACKENDS,
    sudoc = _SUDOC,
    capture_run = _CAPTURE,
    lockstep_diff = _DIFF,
    emit_unpack = _UNPACK,
)

test_suite(
    name = "all",
    tests = [
        ":f8_collision",
        ":imports",
        ":xmod_generics",
        ":xmod_inout",
    ],
)
