# Multi-module lockstep fixtures. These cross-module / import / name-collision
# regression scenarios previously lived in the harness's monolithic
# tests/lockstep.rs (cargo-only). Migrated to the decomposed 7-backend lockstep
# so they run under Bazel — each module set is one sudo_library staged flat and
# diffed across all backends; entry is the importer.

load("@rules_sudo//:defs.bzl", "sudo_library")
load("//tools:backends.bzl", "dogfood_lockstep_test")

# Concrete + constant + cross-module generic instantiation through an import.
sudo_library(
    name = "imports_lib",
    srcs = glob(["imports/*.sudo"]),
)

dogfood_lockstep_test(
    name = "imports",
    lib = ":imports_lib",
    entry = "main.sudo",
)

# Cross-module inout (writeback across a module boundary) + local enum match.
sudo_library(
    name = "xmod_inout_lib",
    srcs = glob(["xmod_inout/*.sudo"]),
)

dogfood_lockstep_test(
    name = "xmod_inout",
    lib = ":xmod_inout_lib",
    entry = "xmod_main.sudo",
)

# F8 regression: length-prefixed qualification keeps module `a`'s `b_c` and
# module `a_b`'s `c` distinct (both naively flatten to `a_b_c`).
sudo_library(
    name = "f8_collision_lib",
    srcs = glob(["f8_collision/*.sudo"]),
)

dogfood_lockstep_test(
    name = "f8_collision",
    lib = ":f8_collision_lib",
    entry = "f8_main.sudo",
)

# Cross-module monomorphized generics (Result/Option/List/Tuple) bound to a
# local then matched — the Zig per-module re-declaration regression.
sudo_library(
    name = "xmod_generics_lib",
    srcs = glob(["xmod_generics/*.sudo"]),
)

dogfood_lockstep_test(
    name = "xmod_generics",
    lib = ":xmod_generics_lib",
    entry = "xmod_gen_main.sudo",
)

test_suite(
    name = "all",
    tests = [
        ":f8_collision",
        ":imports",
        ":xmod_generics",
        ":xmod_inout",
    ],
)
