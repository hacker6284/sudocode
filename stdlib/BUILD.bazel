# Standard-library modules, lockstep-tested across all seven backends (Bazel
# migration Phase 4 — replicates the cargo `sudoc test stdlib/*.sudo` gate).

load("//tools:lockstep.bzl", "sudo_lockstep_test")

# Load-bearing: the syntax/types/stdlib crates read these via data/compile_data.
filegroup(
    name = "sudo_srcs",
    srcs = glob(["*.sudo"]),
    visibility = ["//visibility:public"],
)

_BACKENDS = ["py", "js", "c", "rs", "zig", "swift", "hs"]

# hs is external (protocol 2) — the manifest-free `sudo_external_backend` rule
# (Phase 5): emit-ir -> emit protocol (host GHC) -> emit_unpack, recipe as attrs.
_EXTERNAL = {
    "hs": {
        "emitter": "//backends/haskell:emitter_bin",
        "recipe_build": [["ghc", "-O0", "-rtsopts", "-with-rtsopts=-K8m", "-o", "{entry}_test", "{entry}_test.hs"]],
        "recipe_run": ["./{entry}_test"],
    },
}

# Self-contained modules.
[
    sudo_lockstep_test(
        name = m,
        srcs = [m + ".sudo"],
        entry = m + ".sudo",
        backends = _BACKENDS,
        external = _EXTERNAL,
    )
    for m in [
        "bigint",
        "sorting",
        "strings",
    ]
]

# regex imports strings — stage both, entry is the importer.
sudo_lockstep_test(
    name = "regex",
    srcs = [
        "regex.sudo",
        "strings.sudo",
    ],
    entry = "regex.sudo",
    backends = _BACKENDS,
    external = _EXTERNAL,
)

test_suite(
    name = "all",
    tests = [
        ":bigint",
        ":regex",
        ":sorting",
        ":strings",
    ],
)
