# Standard-library modules, lockstep-tested across all seven backends via the
# @rules_sudo 1.0.0 public macros (Phase 5).

load("@rules_sudo//:defs.bzl", "sudo_library")
load("//tools:backends.bzl", "dogfood_lockstep_test")
load("//tools:complexity.bzl", "sudo_complexity_test")

# Load-bearing: the syntax/types/stdlib crates read these via data/compile_data.
filegroup(
    name = "sudo_srcs",
    srcs = glob(["*.sudo"]),
    visibility = ["//visibility:public"],
)

# Self-contained modules.
[
    sudo_library(
        name = m + "_lib",
        srcs = [m + ".sudo"],
    )
    for m in [
        "bigint",
        "sorting",
        "strings",
    ]
]

[
    dogfood_lockstep_test(
        name = m,
        lib = ":" + m + "_lib",
        entry = m + ".sudo",
    )
    for m in [
        "bigint",
        "sorting",
        "strings",
    ]
]

# regex imports strings — the sudo_library dep stages both; entry is the importer.
sudo_library(
    name = "regex_lib",
    srcs = ["regex.sudo"],
    deps = [":strings_lib"],
)

dogfood_lockstep_test(
    name = "regex",
    lib = ":regex_lib",
    entry = "regex.sudo",
)

# Operation-count complexity regressions (tools/complexity.bzl).
# sort_by must be Theta(n log n) in comparator calls, not O(n^2); join and
# big_to_text must be linear in total output length, not quadratic.
# See stdlib/complexity/*_driver.py.
sudo_complexity_test(
    name = "sorting_sort_by_complexity",
    lib = ":sorting_lib",
    entry = "sorting.sudo",
    driver = "complexity/sort_by_driver.py",
    small_n = 2000,
    large_n = 4000,
    bound = "2.6",  # Theta(n log n) comparator calls, not O(n^2).
                     # A quadratic regression shows ratio ~4; n log n
                     # should land ~2.1-2.3.
)

sudo_complexity_test(
    name = "strings_join_complexity",
    lib = ":strings_lib",
    entry = "strings.sudo",
    driver = "complexity/join_driver.py",
    small_n = 2000,
    large_n = 4000,
    bound = "2.3",  # join must be linear in total output length, not quadratic.
)

sudo_complexity_test(
    name = "bigint_big_to_text_complexity",
    lib = ":bigint_lib",
    entry = "bigint.sudo",
    driver = "complexity/big_to_text_driver.py",
    small_n = 2000,
    large_n = 4000,
    bound = "2.3",  # big_to_text must be linear, not quadratic.
)

test_suite(
    name = "all",
    tests = [
        ":bigint",
        ":regex",
        ":sorting",
        ":strings",
        ":sorting_sort_by_complexity",
        ":strings_join_complexity",
        ":bigint_big_to_text_complexity",
    ],
)

