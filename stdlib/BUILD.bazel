# Standard-library modules, lockstep-tested across all seven backends (Bazel
# migration Phase 4 — replicates the cargo `sudoc test stdlib/*.sudo` gate),
# now driven by the @rules_sudo 1.0.0 public macros (Phase 5).

load("@rules_sudo//:defs.bzl", "sudo_library", "sudo_lockstep_test")

# Load-bearing: the syntax/types/stdlib crates read these via data/compile_data.
filegroup(
    name = "sudo_srcs",
    srcs = glob(["*.sudo"]),
    visibility = ["//visibility:public"],
)

# sudocode dogfoods @rules_sudo, overriding the toolchain-binary attrs to its
# freshly-built first-party binaries. hs is the standalone external backend
# `//backends/haskell:hs`, referenced by label.
_SUDOC = "//sudoc/crates/cli:sudoc"
_CAPTURE = "//sudoc/crates/harness:capture_run"
_DIFF = "//sudoc/crates/harness:lockstep_diff"
_UNPACK = "//sudoc/crates/harness:emit_unpack"

_BACKENDS = ["py", "js", "c", "rs", "zig", "swift", "//backends/haskell:hs"]

# Self-contained modules.
[
    sudo_library(
        name = m + "_lib",
        srcs = [m + ".sudo"],
    )
    for m in [
        "bigint",
        "sorting",
        "strings",
    ]
]

[
    sudo_lockstep_test(
        name = m,
        lib = ":" + m + "_lib",
        entry = m + ".sudo",
        backends = _BACKENDS,
        sudoc = _SUDOC,
        capture_run = _CAPTURE,
        lockstep_diff = _DIFF,
        emit_unpack = _UNPACK,
    )
    for m in [
        "bigint",
        "sorting",
        "strings",
    ]
]

# regex imports strings — the sudo_library dep stages both; entry is the importer.
sudo_library(
    name = "regex_lib",
    srcs = ["regex.sudo"],
    deps = [":strings_lib"],
)

sudo_lockstep_test(
    name = "regex",
    lib = ":regex_lib",
    entry = "regex.sudo",
    backends = _BACKENDS,
    sudoc = _SUDOC,
    capture_run = _CAPTURE,
    lockstep_diff = _DIFF,
    emit_unpack = _UNPACK,
)

test_suite(
    name = "all",
    tests = [
        ":bigint",
        ":regex",
        ":sorting",
        ":strings",
    ],
)
