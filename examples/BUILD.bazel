# Example modules, lockstep-tested across all seven backends (Bazel migration
# Phase 4 — replicates the cargo `sudoc test examples/*.sudo` gate), now driven
# by the @rules_sudo 1.0.0 public macros (Phase 5).

load("@rules_sudo//:defs.bzl", "sudo_library", "sudo_lockstep_test")

# Load-bearing: the syntax/types crates read these via data.
filegroup(
    name = "sudo_srcs",
    srcs = glob(["*.sudo"]),
    visibility = ["//visibility:public"],
)

# sudocode dogfoods @rules_sudo, overriding the toolchain-binary attrs to its
# freshly-built first-party binaries. hs is the standalone external backend
# `//backends/haskell:hs`, referenced by label.
_SUDOC = "//sudoc/crates/cli:sudoc"
_CAPTURE = "//sudoc/crates/harness:capture_run"
_DIFF = "//sudoc/crates/harness:lockstep_diff"
_UNPACK = "//sudoc/crates/harness:emit_unpack"

_BACKENDS = ["py", "js", "c", "rs", "zig", "swift", "//backends/haskell:hs"]

# All examples are self-contained (std-only).
_MODULES = [
    "bfs",
    "binary_search",
    "bst",
    "gcd",
    "insertion_sort",
    "palindrome",
    "quicksort",
    "quine",
    "two_sum",
]

[
    sudo_library(
        name = m + "_lib",
        srcs = [m + ".sudo"],
    )
    for m in _MODULES
]

[
    sudo_lockstep_test(
        name = m,
        lib = ":" + m + "_lib",
        entry = m + ".sudo",
        backends = _BACKENDS,
        sudoc = _SUDOC,
        capture_run = _CAPTURE,
        lockstep_diff = _DIFF,
        emit_unpack = _UNPACK,
    )
    for m in _MODULES
]

test_suite(
    name = "all",
    tests = [":" + m for m in _MODULES],
)
