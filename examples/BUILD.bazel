# Example modules, lockstep-tested across all seven backends via the @rules_sudo
# 1.0.0 public macros (Phase 5).

load("@rules_sudo//:defs.bzl", "sudo_library")
load("//tools:backends.bzl", "dogfood_lean_canary_test", "dogfood_lockstep_test")

# Load-bearing: the syntax/types crates read these via data.
filegroup(
    name = "sudo_srcs",
    srcs = glob(["*.sudo"]),
    visibility = ["//visibility:public"],
)

# All examples are self-contained (std-only).
_MODULES = [
    "bfs",
    "binary_search",
    "bst",
    "gcd",
    "insertion_sort",
    "palindrome",
    "quicksort",
    "quine",
    "two_sum",
]

[
    sudo_library(
        name = m + "_lib",
        srcs = [m + ".sudo"],
    )
    for m in _MODULES
]

[
    dogfood_lockstep_test(
        name = m,
        lib = ":" + m + "_lib",
        entry = m + ".sudo",
    )
    for m in _MODULES
]

[
    dogfood_lean_canary_test(
        name = m + "_lean",
        lib = ":" + m + "_lib",
        entry = m + ".sudo",
    )
    for m in _MODULES
]

test_suite(
    name = "all",
    tests = [":" + m for m in _MODULES],
)

test_suite(
    name = "lean_canary",
    tests = [":" + m + "_lean" for m in _MODULES],
    tags = ["manual"],
)
